# Development Settings
ENV=DEVELOPMENT

# Local AI provider (recommended default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_INPUT_CHARS=12000

# Optional cloud providers
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# AI_PROVIDER=huggingface
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL_ID=sshleifer/distilbart-cnn-12-6

# Local text-to-speech provider
TTS_PROVIDER=macos_say
MACOS_SAY_VOICE=Samantha

# Optional OpenAI TTS
# TTS_PROVIDER=openai
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# Database (DATABASE_URL is required; apply schema with `alembic upgrade head`)
POSTGRES_DB=summarizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:6703/summarizer
# DB_AUTO_CREATE=true  # dev/test only: create tables on startup without Alembic
# LOG_LEVEL=INFO
